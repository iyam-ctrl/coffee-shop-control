{
  "name": "coffee-shop-control",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": "22.x" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:cashier": "pnpm --filter @coffee-shop/cashier dev",
    "dev:manager": "pnpm --filter @coffee-shop/manager dev",
    "dev:owner": "pnpm --filter @coffee-shop/owner dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "pnpm -r lint"
  }
}
